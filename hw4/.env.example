# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# Never commit .env.

# Required: Portkey API key used for the OpenAI model calls
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional (defaults shown)
MODEL_NAME=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: secret that signs login session tokens. If unset, the backend creates
# a random one in backend/.session_secret (git-ignored).
SESSION_SECRET=replace_with_a_long_random_string
